{
  "name": "@digitalindustriesco/shop-cli",
  "version": "0.1.1",
  "description": "Framework-neutral, safety-first primitives for operational CLIs.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DigitalIndustriesCo/shop-cli.git"
  },
  "bugs": {
    "url": "https://github.com/DigitalIndustriesCo/shop-cli/issues"
  },
  "homepage": "https://github.com/DigitalIndustriesCo/shop-cli#readme",
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.18.8",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
